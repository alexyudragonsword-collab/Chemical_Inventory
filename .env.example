# Runtime connection (limited role: no UPDATE/DELETE on audit_event)
DATABASE_URL="postgresql://chemtrack_app:app_dev@localhost:5432/chemtrack"

# Owner connection, used only for `prisma migrate deploy`
MIGRATE_DATABASE_URL="postgresql://chemtrack_owner:owner_dev@localhost:5432/chemtrack"

# Auth.js
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# File storage root (SDS documents etc.)
FILE_STORAGE_ROOT="/data/files"

# SMTP relay for scheduled reports (optional in dev)
SMTP_HOST=""
SMTP_PORT="25"
SMTP_FROM="chemtrack@lab.internal"
EHS_REPORT_RECIPIENTS=""
