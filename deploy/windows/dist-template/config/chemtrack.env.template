# ChemTrack runtime configuration - generated by install.ps1.
# The start/stop scripts inject these values explicitly; edit only while
# ChemTrack is stopped.

DATABASE_URL={{DATABASE_URL}}
MIGRATE_DATABASE_URL={{MIGRATE_DATABASE_URL}}
AUTH_SECRET={{AUTH_SECRET}}
AUTH_TRUST_HOST=true
PORT={{PORT}}
HOSTNAME=127.0.0.1
PGPORT={{PGPORT}}
FILE_STORAGE_ROOT={{FILE_STORAGE_ROOT}}
NODE_ENV=production

# Optional SMTP relay for the monthly regulated-substances email.
# Leave SMTP_HOST empty to skip sending (the worker handles this gracefully).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=chemtrack@lab.internal
EHS_REPORT_RECIPIENTS=
