{
  "name": "chemtrack",
  "version": "0.1.0",
  "private": true,
  "description": "ChemTrack — laboratory chemical inventory system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:legacy": "tsx scripts/import/cli.ts",
    "verify:audit": "tsx scripts/verify-audit-chain.ts",
    "package:win": "bash deploy/windows/build-package.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
